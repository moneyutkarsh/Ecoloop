! Baseline 3-Zone Commercial Office Building EnergyPlus Model
! Compatible with EnergyPlus v23/v24

Version, 23.2;

Building,
    Commercial Office Building, ! Name
    0.0,                        ! North Axis {deg}
    Suburbs,                    ! Terrain
    0.04,                       ! Loads Convergence Tolerance Value {W}
    0.4,                        ! Temperature Convergence Tolerance Value {deltaC}
    FullExterior,               ! Solar Distribution
    25,                         ! Maximum Number of Warmup Days
    6;                          ! Minimum Number of Warmup Days

Timestep, 4;

SimulationControl,
    Yes,                        ! Do Zone Sizing Calculation
    Yes,                        ! Do System Sizing Calculation
    No,                         ! Do Plant Sizing Calculation
    Yes,                        ! Run Simulation for Sizing Periods
    Yes;                        ! Run Simulation for Weather File Days

Site:Location,
    Chicago O'Hare Intl AP IL USA,  ! Name
    41.98,                      ! Latitude {deg}
    -87.92,                     ! Longitude {deg}
    -6.0,                       ! Time Zone {hr}
    201.0;                      ! Elevation {m}

! -------------------------------------------------------------
! Zones
! -------------------------------------------------------------
Zone,
    Open_Office,                ! Name
    0,                          ! Direction of Relative North {deg}
    0, 0, 0,                    ! X,Y,Z {m}
    1,                          ! Type
    1,                          ! Multiplier
    2.8,                        ! Ceiling Height {m}
    280.0;                      ! Volume {m3}

Zone,
    Executive_Suite,            ! Name
    0,                          ! Direction of Relative North {deg}
    10, 0, 0,                   ! X,Y,Z {m}
    1,                          ! Type
    1,                          ! Multiplier
    2.8,                        ! Ceiling Height {m}
    140.0;                      ! Volume {m3}

Zone,
    Conference_Room,            ! Name
    0,                          ! Direction of Relative North {deg}
    0, 10, 0,                   ! X,Y,Z {m}
    1,                          ! Type
    1,                          ! Multiplier
    2.8,                        ! Ceiling Height {m}
    140.0;                      ! Volume {m3}

! -------------------------------------------------------------
! Materials & Constructions
! -------------------------------------------------------------
Material,
    Concrete Block,             ! Name
    MediumRough,                ! Roughness
    0.10,                       ! Thickness {m}
    0.51,                       ! Conductivity {W/m-K}
    1400,                       ! Density {kg/m3}
    1000,                       ! Specific Heat {J/kg-K}
    0.9,                        ! Thermal Absorptance
    0.7,                        ! Solar Absorptance
    0.7;                        ! Visible Absorptance

Material,
    Insulation Board,           ! Name
    MediumRough,                ! Roughness
    0.05,                       ! Thickness {m}
    0.03,                       ! Conductivity {W/m-K}
    40,                         ! Density {kg/m3}
    1200,                       ! Specific Heat {J/kg-K}
    0.9,                        ! Thermal Absorptance
    0.7,                        ! Solar Absorptance
    0.7;                        ! Visible Absorptance

Construction,
    Exterior Wall Construction, ! Name
    Concrete Block,             ! Layer 1
    Insulation Board;           ! Layer 2

! -------------------------------------------------------------
! Internal Loads & Schedules
! -------------------------------------------------------------
ScheduleTypeLimits,
    Fraction,                   ! Name
    0.0, 1.0, Continuous;       ! Lower, Upper, Type

Schedule:Compact,
    OccupancySchedule,          ! Name
    Fraction,                   ! Schedule Type Limits Name
    Through: 12/31,             ! Complex field 1
    For: AllDays,               ! Complex field 2
    Until: 08:00, 0.0,          ! Complex field 3
    Until: 12:00, 1.0,          ! Complex field 4
    Until: 13:00, 0.5,          ! Complex field 5
    Until: 18:00, 1.0,          ! Complex field 6
    Until: 24:00, 0.0;          ! Complex field 7

People,
    Open_Office_People,         ! Name
    Open_Office,                ! Zone Name
    OccupancySchedule,          ! Number of People Schedule Name
    People,                     ! Number of People Calculation Method
    10,                         ! Number of People
    ,                           ! People per Zone Floor Area {person/m2}
    ,                           ! Zone Floor Area per Person {m2/person}
    0.3,                        ! Fraction Radiant
    ,                           ! Sensible Heat Fraction
    ActivitySchedule;           ! Activity Level Schedule Name

Schedule:Compact,
    ActivitySchedule,           ! Name
    Any Number,                 ! Schedule Type Limits Name
    Through: 12/31,             ! Field 1
    For: AllDays,               ! Field 2
    Until: 24:00, 120.0;        ! Field 3 (120 W/person office work)

Lights,
    Open_Office_Lights,         ! Name
    Open_Office,                ! Zone Name
    OccupancySchedule,          ! Schedule Name
    LightingLevel,              ! Lighting Level Calculation Method
    1000.0,                     ! Lighting Level {W}
    ,                           ! Watts per Zone Floor Area {W/m2}
    ,                           ! Watts per Person {W/person}
    0.0,                        ! Return Air Fraction
    0.5,                        ! Fraction Radiant
    0.2;                        ! Fraction Visible

! -------------------------------------------------------------
! Thermostat Controls & EMS Actuators
! -------------------------------------------------------------
ThermostatSetpoint:DualSetpoint,
    Office Dual Setpoint,       ! Name
    HeatingSetpointSchedule,    ! Heating Setpoint Temperature Schedule Name
    CoolingSetpointSchedule;    ! Cooling Setpoint Temperature Schedule Name

Schedule:Compact,
    HeatingSetpointSchedule,    ! Name
    Temperature,                ! Schedule Type Limits Name
    Through: 12/31, For: AllDays, Until: 24:00, 20.0;

Schedule:Compact,
    CoolingSetpointSchedule,    ! Name
    Temperature,                ! Schedule Type Limits Name
    Through: 12/31, For: AllDays, Until: 24:00, 22.5;

ZoneControl:Thermostat,
    Open_Office Thermostat,     ! Name
    Open_Office,                ! Zone Name
    Office Thermostat Control,  ! Control Type Schedule Name
    ThermostatSetpoint:DualSetpoint, ! Control 1 Object Type
    Office Dual Setpoint;       ! Control 1 Name

Schedule:Compact,
    Office Thermostat Control,  ! Name
    Control Type,               ! Schedule Type Limits Name
    Through: 12/31, For: AllDays, Until: 24:00, 4; ! Dual setpoint control
